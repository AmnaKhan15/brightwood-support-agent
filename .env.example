# Copy to .env for local runs (the API server reads it on start). Never commit the real file.
# Everything is optional: with nothing set, the app runs fully offline (SQLite, in-process Redis, offline assistant).

# --- Models (Gemini via LangChain) ---
GEMINI_API_KEY=
# A fast model id from aistudio.google.com, and an optional stronger one (also the fine-tuning teacher)
GEMINI_MODEL=
GEMINI_STRONG_MODEL=
GEMINI_EMBED_MODEL=models/gemini-embedding-001
# off = word search only
SEMANTIC_SEARCH=on
# LLM-as-judge for evals (defaults to GEMINI_STRONG_MODEL)
JUDGE_MODEL=
# Blended USD price per 1k tokens, for the cost metrics
MODEL_PRICE_PER_1K_TOKENS=
DAILY_AI_CALLS=150

# --- Data ---
# postgresql://... (Neon, with pgvector). Empty = in-memory SQLite
DATABASE_URL=
# rediss://... (Upstash). Empty = in-process fake Redis, and jobs run inline
REDIS_URL=
EMBEDDED_WORKER=true

# --- Staff sign-in ---
# true lets anyone try both roles (demo). false plus STAFF_ACCESS_CODE for real use
DEMO_STAFF_LOGIN=true
STAFF_ACCESS_CODE=

# --- Payments (Stripe TEST mode only) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Observability ---
LOG_LEVEL=INFO
# Grafana Cloud OTLP gateway, and its header: Authorization=Basic <base64 instance:token>
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=brightwood-support-agent

# --- Fine-tuning on Vertex AI (finetune/) ---
GEMINI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
TUNING_BASE_MODEL=gemini-2.5-flash-lite

PORT=8000
